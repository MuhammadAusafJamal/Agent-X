{
  "name": "agent-x",
  "version": "0.0.0",
  "private": true,
  "description": "Agent X - automated QA testing tool",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @agentx/web",
    "dev:api": "npm run start:dev --workspace @agentx/api",
    "dev:shared": "npm run dev --workspace @agentx/shared",
    "build": "npm run build --workspace @agentx/shared && npm run build --workspace @agentx/api && npm run build --workspace @agentx/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @agentx/api",
    "db:migrate": "npm run db:migrate --workspace @agentx/api",
    "db:studio": "npm run db:studio --workspace @agentx/api",
    "db:reset": "npm run db:reset --workspace @agentx/api",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
