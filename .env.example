# Copy to apps/api/.env and fill in. .env is gitignored; never commit real values.
# Every key here is validated at boot by apps/api/src/config/env.schema.ts —
# a missing or malformed value fails the process with a list of what to fix.

NODE_ENV=development

# API listen port. The dashboard's dev server holds 3000.
PORT=3001

# CORS allowlist — the dashboard origin.
WEB_ORIGIN=http://localhost:3000

# SQLite connection string. A relative file: path is resolved against the REPO
# ROOT, not the working directory, so the CLI and the API always agree on it.
DATABASE_URL="file:data/agentx.db"

# Root of the evidence tree (traces, video, screenshots, DOM/network/console logs).
EVIDENCE_DIR=../../data/evidence

# Required. The agent cannot plan, resolve, verify, diagnose, or heal without it.
ANTHROPIC_API_KEY=

# One model for every agent role. Swap to claude-opus-5 to trade latency for reasoning.
ANTHROPIC_MODEL=claude-sonnet-5

# The recorder needs a visible browser, so this is false by default.
PLAYWRIGHT_HEADLESS=false
